      "writtenOn": "2025-08-08T15:21:54Z",
      "side": 1,
      "message": "Is this this also assuming that e.g. no atomics are accessed after `power_down_level0` returns?",
      "revId": "a0837208ea66b941fb162f1fdf91482546961d02",
      "serverId": "8f6f209b-db1a-4cbf-aa44-c8bc30e9bfda"
