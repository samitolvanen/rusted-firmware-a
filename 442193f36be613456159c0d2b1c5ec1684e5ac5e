      "lineNbr": 425,
      "author": {
        "id": 1000159
      },
      "writtenOn": "2025-08-08T12:07:30Z",
      "side": 1,
      "message": "I agree, we should prevent anything like an SWd -\u003e NWd FFA_INTERRUPT happening in this state, because the normal world is not ready to receive it.",
